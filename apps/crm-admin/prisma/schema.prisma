generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  companyName String?  @map("company_name")
  industry    String?
  status      ClientStatus @default(LEAD)
  contactInfo Json?    @map("contact_info")
  createdAt   DateTime @default(now()) @map("created_at")

  projects    Project[]
  touchpoints Touchpoint[]

  @@map("clients")
}

model Project {
  id            String        @id @default(cuid())
  clientId      String        @map("client_id")
  templateType  String?       @map("template_type")
  repoPath      String?       @map("repo_path")
  productionUrl String?       @map("production_url")
  carePlan      Boolean       @default(false) @map("care_plan")
  renewalDate   DateTime?     @map("renewal_date")
  status        ProjectStatus @default(IN_PROGRESS)
  createdAt     DateTime      @default(now()) @map("created_at")

  client                Client                @relation(fields: [clientId], references: [id])
  maintenanceRequests   MaintenanceRequest[]

  @@map("projects")
}

model Touchpoint {
  id           String   @id @default(cuid())
  clientId     String   @map("client_id")
  contactDate  DateTime @map("contact_date")
  followupDate DateTime? @map("followup_date")
  method       String   // email | dm | call
  outcome      String?

  client Client @relation(fields: [clientId], references: [id])

  @@map("touchpoints")
}

model MaintenanceRequest {
  id             String          @id @default(cuid())
  projectId      String          @map("project_id")
  type           MaintenanceType
  hours          Float?
  billedAmount   Decimal?        @map("billed_amount")
  completionDate DateTime?       @map("completion_date")
  notes          String?

  project Project @relation(fields: [projectId], references: [id])

  @@map("maintenance_requests")
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAST
}

enum ProjectStatus {
  IN_PROGRESS
  LAUNCHED
  ON_HOLD
  CANCELLED
}

enum MaintenanceType {
  NORMAL
  EMERGENCY
}
